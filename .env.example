# 复制为 .env 后填写（本文件不含任何真实密钥）
# 不填也能用：未配置 LLM key 时自动按 off 档运行（采集/打分/聚类/手写预言/验证全可用）

# ── LLM（默认 DeepSeek，OpenAI 兼容协议）────────────────────────────
AIPULSE_LLM__BASE_URL=https://api.deepseek.com/v1
AIPULSE_LLM__API_KEY=

# ── 数据源凭证（均为可选）────────────────────────────────────────────
GITHUB_TOKEN=            # 可选，强烈建议：30 req/min（无 token 为 10 req/min）
HF_TOKEN=                # 可选，提高 HuggingFace 限额
# REDDIT_CLIENT_ID=      # v1.2 决策：走免认证 RSS，OAuth 不实现，仅留配置项
# REDDIT_CLIENT_SECRET=

# ── 网络（WSL / 内网环境可能需要）───────────────────────────────────
# HTTP_PROXY=
# HTTPS_PROXY=

# ── 其他 ─────────────────────────────────────────────────────────────
# AIPULSE_ROOT=          # 覆盖项目根目录（测试用）
# AIPULSE_DB_URL=        # 覆盖 alembic 目标库（测试用）
